# Raw archive material and intermediates stay out of git -- they are large and
# reproducible from the pipeline. The parsed YAML is committed so the GitHub
# Action can build the site without re-downloading anything.
/data/*
!/data/parsed
/data/parsed/*
!/data/parsed/nodes
!/data/parsed/users
!/data/parsed/files
!/data/parsed/misc
# Regenerable intermediate (17 MB): step 6 writes it, step 7 consumes it, and
# the site build never reads it. _index.jsonl IS needed by the build.
/data/parsed/users/_observations.jsonl
# Local parse cache for /user/<id> pages (2.4 MB); regenerated by step 7.
/data/parsed/users/_profiles.json
!/data/parsed/parse.log
!/data/parsed/parse.meta.json
!/data/parsed/old-urls.log
!/data/parsed/messages
!/data/parsed/messages.log
!/data/parsed/messages.meta.json

/node_modules
**/__*
